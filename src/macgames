#!/usr/bin/env bash
# macgames — run Windows games on Apple Silicon (Rosetta 2 + Wine + DirectX→Metal).
# Proof of concept. See README.md.
set -euo pipefail

# Layout: src/ is our code, dependencies/ holds downloaded and built third-party
# software, games/<appid>/ per-game settings, env/.env local settings and
# secrets, bottles/ the Wine prefixes. ./macgames at the root links here.
SRC="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ROOT="$(dirname "$SRC")"
TOOLS="$SRC/tools"
DEPS="$ROOT/dependencies"
GAMES="$ROOT/games"
BOTTLES="$ROOT/bottles"
ENV_FILE="$ROOT/env/.env"
DL="$DEPS/downloads"

# Pinned runtime versions.
WINE_VER="11.21"
WINE_URL="https://github.com/Gcenx/macOS_Wine_builds/releases/download/$WINE_VER/wine-staging-$WINE_VER-osx64.tar.xz"
DXMT_VER="v0.80"
DXMT_URL="https://github.com/3Shain/dxmt/releases/download/$DXMT_VER/dxmt-$DXMT_VER-builtin.tar.gz"
GPTK_VER="3.0-3"
GPTK_URL="https://github.com/Gcenx/game-porting-toolkit/releases/download/Game-Porting-Toolkit-$GPTK_VER/game-porting-toolkit-$GPTK_VER.tar.xz"
STEAM_URL="https://cdn.akamai.steamstatic.com/client/installer/SteamSetup.exe"

STEAM_EXE='C:\Program Files (x86)\Steam\steam.exe'

die()  { echo "error: $*" >&2; exit 1; }
info() { echo "==> $*" >&2; }
is_true() { case "$1" in 1|[Tt][Rr][Uu][Ee]|[Yy][Ee][Ss]|[Oo][Nn]) return 0 ;; *) return 1 ;; esac; }

# env/.env holds KEY=value lines (see env/.env.example). Variables already set
# in the shell win, so `SHOW_BENCHMARKS=true ./macgames ...` overrides the file.
# They're not exported, so secrets like STEAM_PIN don't reach Wine processes.
load_env() {
  [[ -f "$ENV_FILE" ]] || return 0
  local line key val
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    line="${line#export }"
    key="${line%%=*}" val="${line#*=}"
    [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ && "$line" == *=* ]] || continue
    [[ "$val" =~ ^\"(.*)\"$ || "$val" =~ ^\'(.*)\'$ ]] && val="${BASH_REMATCH[1]}"
    [[ -n "${!key+x}" ]] || printf -v "$key" '%s' "$val"
  done < "$ENV_FILE"
}

# ---------------------------------------------------------------- runtimes

# Each backend maps to a Wine build and a Direct3D translation strategy:
#   wined3d  — Wine 11.21; D3D9/10/11 → OpenGL, D3D12 → vkd3d → Vulkan → Metal.
#   dxmt     — Wine 11.21 with DXMT builtins; D3D10/11 → Metal (fast), and
#              D3D12 still via Wine's vkd3d. Runs Steam. The default.
#   d3dmetal — Apple Game Porting Toolkit (Wine 7.7) with D3DMetal; D3D11/12 →
#              Metal. Wine 7.7 is too old for the modern Steam client (it
#              crashes on launch), so this backend is only for running a game's
#              own .exe directly, not for Steam.
#
# wined3d and dxmt share the same Wine 11.21 build, so both run Steam and both
# reach D3D12 through vkd3d. On Apple M5 that path tops out at feature level
# 11_0 (see tools/d3d12-probe); games needing 12_1-only features won't start.
wine_bin_dir() {
  case "$1" in
    wined3d)  echo "$DEPS/wine/Wine Staging.app/Contents/Resources/wine/bin" ;;
    dxmt)     echo "$DEPS/wine-dxmt/Wine Staging.app/Contents/Resources/wine/bin" ;;
    d3dmetal) echo "$DEPS/gptk/Game Porting Toolkit.app/Contents/Resources/wine/bin" ;;
    *) die "unknown backend '$1' (wined3d|dxmt|d3dmetal)" ;;
  esac
}

wine_exe() { # backend -> path to wine launcher (GPTK ships it as wine64)
  local bin; bin="$(wine_bin_dir "$1")"
  if [[ -x "$bin/wine" ]]; then echo "$bin/wine"; else echo "$bin/wine64"; fi
}

# Note: bottles made by one Wine build must not be opened by another, so the
# backend is fixed when a bottle is created and never changed afterwards.

fetch() { # url
  local f="$DL/$(basename "$1")"
  [[ -f "$f" ]] || { info "downloading $(basename "$1")"; curl -fL --progress-bar -o "$f.part" "$1" && mv "$f.part" "$f"; }
  echo "$f"
}

cmd_setup() {
  [[ "$(uname -m)" == arm64 ]] || die "this tool targets Apple Silicon"
  if ! /usr/bin/pgrep -q oahd; then
    info "installing Rosetta 2"
    softwareupdate --install-rosetta --agree-to-license
  fi
  mkdir -p "$DL" "$BOTTLES"

  if [[ ! -d "$DEPS/wine" ]]; then
    local f; f="$(fetch "$WINE_URL")"
    mkdir -p "$DEPS/wine" && tar -xf "$f" -C "$DEPS/wine"
  fi

  if [[ ! -d "$DEPS/wine-dxmt" ]]; then
    local f; f="$(fetch "$DXMT_URL")"
    mkdir -p "$DEPS/dxmt" && tar -xzf "$f" -C "$DEPS/dxmt"
    info "building DXMT Wine variant (APFS clone, ~0 extra disk)"
    cp -Rc "$DEPS/wine" "$DEPS/wine-dxmt"
    local lib="$DEPS/wine-dxmt/Wine Staging.app/Contents/Resources/wine/lib/wine"
    local src="$DEPS/dxmt/$DXMT_VER"
    cp "$src"/x86_64-unix/*    "$lib/x86_64-unix/"
    cp "$src"/x86_64-windows/* "$lib/x86_64-windows/"
    cp "$src"/i386-windows/*   "$lib/i386-windows/"
  fi

  # DXMT can't reach the window's Metal layer through stock Wine 11's winemac.so
  # ("Failed to create metal view"); rebuild it with tools/winemac-dxmt.
  local winemac="$DEPS/wine-dxmt/Wine Staging.app/Contents/Resources/wine/lib/wine/x86_64-unix/winemac.so"
  if ! nm -gU "$winemac" 2>/dev/null | grep _macdrv_functions >/dev/null; then
    info "building DXMT-compatible winemac.so (one-off, a few minutes)"
    "$TOOLS/winemac-dxmt/build.sh" "$WINE_VER" "$winemac" "$DEPS/wine-build"
  fi

  if [[ ! -d "$DEPS/gptk" ]]; then
    local f; f="$(fetch "$GPTK_URL")"
    mkdir -p "$DEPS/gptk" && tar -xf "$f" -C "$DEPS/gptk"
  fi

  xattr -dr com.apple.quarantine "$DEPS" 2>/dev/null || true
  info "dependencies ready: wine-staging $WINE_VER, dxmt $DXMT_VER, gptk $GPTK_VER"
}

# ---------------------------------------------------------------- bottles

bottle_dir() { echo "$BOTTLES/$1"; }

load_bottle() { # name -> sets BACKEND, WINEPREFIX
  local dir; dir="$(bottle_dir "$1")"
  [[ -f "$dir/bottle.conf" ]] || die "no bottle '$1' (create it with: macgames create $1)"
  BACKEND=""; # shellcheck disable=SC1091
  source "$dir/bottle.conf"
  export WINEPREFIX="$dir/prefix"
}

# Run a Wine command in a bottle. Backend may be overridden within the same family.
wine_in() { # bottle backend cmd...
  local bottle="$1" backend="$2"; shift 2
  local wine; wine="$(wine_exe "$backend")"
  [[ -x "$wine" ]] || die "runtime for '$backend' missing — run: macgames setup"
  export WINEDEBUG="${WINEDEBUG:--all}"
  export WINEESYNC=1 WINEMSYNC=1
  benchmarks_env
  case "$backend" in
    d3dmetal) export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}dxgi,d3d9,d3d10core,d3d11,d3d12=b" ;;
    # METALFX=1: render below native and let Apple's MetalFX upscale to the
    # Retina panel (DXMT's d3d11.metalSpatialUpscaleFactor sets the ratio).
    dxmt) is_true "${METALFX:-0}" && export DXMT_METALFX_SPATIAL_SWAPCHAIN=1 ;;
  esac
  local log="$(bottle_dir "$bottle")/last-run.log"
  "$wine" "$@" 2>&1 | tee "$log"
}

# SHOW_BENCHMARKS=true turns on Apple's Metal performance HUD (FPS, frame
# time, GPU time, memory) in the top-right corner of every Metal window. Games
# inherit it from Steam, so it appears as soon as a game starts rendering.
benchmarks_env() {
  is_true "${SHOW_BENCHMARKS:-false}" || return 0
  export MTL_HUD_ENABLED=1 MTL_HUD_ALIGNMENT="${BENCHMARKS_POSITION:-topright}"
}

cmd_create() { # name [backend]
  local name="${1:?usage: macgames create <name> [wined3d|dxmt|d3dmetal]}" backend="${2:-dxmt}"
  wine_bin_dir "$backend" >/dev/null
  local dir; dir="$(bottle_dir "$name")"
  [[ -e "$dir" ]] && die "bottle '$name' already exists"
  mkdir -p "$dir/prefix"
  echo "BACKEND=$backend" > "$dir/bottle.conf"
  export WINEPREFIX="$dir/prefix"
  info "initialising bottle '$name' ($backend)"
  WINEDEBUG=-all "$(wine_exe "$backend")" wineboot --init >/dev/null 2>&1
  # Windows 10 reporting keeps modern launchers happy.
  WINEDEBUG=-all "$(wine_exe "$backend")" reg add 'HKCU\Software\Wine' /v Version /d win10 /f >/dev/null 2>&1
  info "bottle ready: $dir"
}

cmd_list() {
  shopt -s nullglob
  for d in "$BOTTLES"/*/bottle.conf; do
    local name; name="$(basename "$(dirname "$d")")"
    printf '%-20s %s\n' "$name" "$(grep BACKEND "$d")"
  done
}

cmd_delete() {
  local name="${1:?usage: macgames delete <name>}"
  load_bottle "$name"
  "$(wine_bin_dir "$BACKEND")/wineserver" -k 2>/dev/null || true
  rm -rf "$(bottle_dir "$name")"
  info "deleted '$name'"
}

# ---------------------------------------------------------------- running

cmd_run() { # bottle exe [args...]
  local bottle="${1:?usage: macgames run <bottle> <exe> [args...]}" exe="${2:?missing exe}"; shift 2
  load_bottle "$bottle"
  wine_in "$bottle" "$BACKEND" "$exe" "$@"
}

cmd_kill() {
  local bottle="${1:?usage: macgames kill <bottle>}"
  load_bottle "$bottle"
  "$(wine_bin_dir "$BACKEND")/wineserver" -k || true
}

# Run the bundled D3D12 probe in a bottle to confirm the Direct3D → Metal path
# works there, without needing a game installed.
cmd_doctor() {
  local bottle="${1:?usage: macgames doctor <bottle>}"
  load_bottle "$bottle"
  local probe="$TOOLS/d3d12-probe/probe.exe"
  [[ -f "$probe" ]] || die "missing $probe"
  info "probing Direct3D 12 in '$bottle' ($BACKEND)"
  WINEDEBUG=-all "$(wine_exe "$BACKEND")" "$probe" 2>/dev/null
}

# ---------------------------------------------------------------- steam

steam_dir() { echo "$WINEPREFIX/drive_c/Program Files (x86)/Steam"; }

# Steam's 32-bit updater crashes under wine-staging while fetching the 64-bit
# client, and the 64-bit client crashes under GPTK Wine. So the update runs in a
# throwaway GPTK bottle and the finished Steam folder is copied over.
bootstrap_steam() { # -> path of an up-to-date Steam folder
  local boot="$BOTTLES/.steam-bootstrap"
  local dir="$boot/prefix/drive_c/Program Files (x86)/Steam"
  if [[ ! -f "$dir/package/steam_client_win64.installed" ]]; then
    [[ -f "$boot/bottle.conf" ]] || cmd_create .steam-bootstrap d3dmetal >&2
    load_bottle .steam-bootstrap
    [[ -f "$dir/steam.exe" ]] || wine_in .steam-bootstrap d3dmetal "$(fetch "$STEAM_URL")" /S >/dev/null
    info "downloading the Steam client (one-off, ~300 MB)"
    wine_in .steam-bootstrap d3dmetal "$STEAM_EXE" "${STEAM_FLAGS[@]}" >/dev/null &
    local i
    for ((i = 0; i < 180; i++)); do
      [[ -f "$dir/package/steam_client_win64.installed" ]] && break
      sleep 5
    done
    sleep 5
    "$(wine_bin_dir d3dmetal)/wineserver" -k 2>/dev/null || true
    wait 2>/dev/null || true
    [[ -f "$dir/package/steam_client_win64.installed" ]] || die "Steam client download did not finish"
  fi
  echo "$dir"
}

cmd_install_steam() {
  local bottle="${1:?usage: macgames install-steam <bottle>}"
  load_bottle "$bottle"
  [[ "$BACKEND" == d3dmetal ]] && die "the modern Steam client crashes under the d3dmetal backend (Wine 7.7); create a dxmt or wined3d bottle for Steam"
  info "installing Windows Steam into '$bottle'"
  wine_in "$bottle" "$BACKEND" "$(fetch "$STEAM_URL")" /S >/dev/null
  local src; src="$(bootstrap_steam)"
  load_bottle "$bottle"
  local dst; dst="$(steam_dir)"
  [[ -d "$dst/steamapps" ]] && die "'$dst' already has games; not overwriting"
  rm -rf "$dst" && cp -Rc "$src" "$dst" && rm -f "$dst"/*.old
  info "done — start it with: macgames steam $bottle"
}

# Steam's Chromium UI paints a black window under Wine on macOS unless
# steamwebhelper runs with --disable-gpu --single-process. Steam doesn't pass
# those through, so tools/webhelper-wrapper stands in for steamwebhelper.exe
# and starts Valve's helper (moved to steamwebhelper_real.exe) with them.
# -noverifyfiles stops Steam from restoring the original helper.
STEAM_FLAGS=(-noverifyfiles -cef-disable-sandbox)
WEBHELPER_WRAPPER="$TOOLS/webhelper-wrapper/steamwebhelper.exe"

install_webhelper_wrapper() { # needs WINEPREFIX
  local cef
  for cef in "$(steam_dir)"/bin/cef/cef.win*; do
    [[ -f "$cef/steamwebhelper.exe" ]] || continue
    cmp -s "$WEBHELPER_WRAPPER" "$cef/steamwebhelper.exe" && continue
    # Steam updates replace steamwebhelper.exe with Valve's; stash the new one.
    mv -f "$cef/steamwebhelper.exe" "$cef/steamwebhelper_real.exe"
    cp "$WEBHELPER_WRAPPER" "$cef/steamwebhelper.exe"
  done
}

# Wine on macOS defaults to 1 Windows pixel per screen *point*, which halves
# the resolution on a Retina display. RetinaMode maps 1:1 to real pixels, and
# 192 DPI (200% scaling) keeps text and UI at their normal size. RETINA=0 opts out.
apply_display_settings() { # bottle backend
  local want=y dpi=192
  [[ "${RETINA:-1}" == 0 ]] && want=n dpi=96
  grep -q "\"RetinaMode\"=\"$want\"" "$WINEPREFIX/user.reg" 2>/dev/null && return
  local wine; wine="$(wine_exe "$2")"
  reg() { WINEDEBUG=-all "$wine" reg add "$@" /f >/dev/null 2>&1; }
  reg 'HKCU\Software\Wine\Mac Driver' /v RetinaMode /t REG_SZ /d "$want"
  reg 'HKCU\Control Panel\Desktop' /v LogPixels /t REG_DWORD /d "$dpi"
  reg 'HKLM\System\CurrentControlSet\Hardware Profiles\Current\Software\Fonts' /v LogPixels /t REG_DWORD /d "$dpi"
}

# Copy each games/<appid>/game.conf ARGS into Steam's Launch Options so the Play
# button uses them too. Steam rewrites localconfig.vdf on exit, so only while it's stopped.
sync_launch_options() {
  steam_running && return
  local cfg conf appid
  for cfg in "$(steam_dir)"/userdata/*/config/localconfig.vdf; do
    [[ -f "$cfg" ]] || continue
    for conf in "$GAMES"/*/game.conf; do
      appid="$(basename "$(dirname "$conf")")"
      local NAME="" ARGS="" ENV=""; # shellcheck disable=SC1090
      source "$conf"
      [[ -n "$ARGS" ]] && python3 -I "$TOOLS/steam-launch-options.py" "$cfg" "$appid" "$ARGS" 2>/dev/null || true
    done
  done
}

# Settings that games inherit from the running Steam rather than from the
# `launch` that asked for them; Steam restarts when these change.
steam_session() { echo "SHOW_BENCHMARKS=$(is_true "${SHOW_BENCHMARKS:-}" && echo 1 || echo 0) METALFX=$(is_true "${METALFX:-}" && echo 1 || echo 0)"; }
steam_session_file() { echo "$(bottle_dir "$1")/steam-session"; }

# Run Steam inside a Wine virtual desktop the size of the Mac screen.
steam_in() { # bottle [steam args...]
  local bottle="$1"; shift
  steam_running || steam_session > "$(steam_session_file "$bottle")"
  install_webhelper_wrapper
  sync_launch_options
  apply_display_settings "$bottle" "$BACKEND"
  local size="${DESKTOP:-}" scale=2
  [[ "${RETINA:-1}" == 0 ]] && scale=1
  if [[ -z "$size" ]]; then
    size="$(osascript -e 'tell application "Finder" to get bounds of window of desktop' 2>/dev/null |
      awk -F', ' -v s="$scale" '{print $3 * s "x" $4 * s}')"
  fi
  rm -f "$WINEPREFIX"/drive_c/users/*/AppData/Local/Steam/htmlcache/Singleton*
  # The Steam overlay hooks every game's DXGI swapchain; on top of DXMT that
  # crashes games at startup (Dead as Disco aborts while its Streamline/XeSS
  # plugins load). Games inherit this from Steam.
  export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}gameoverlayrenderer,gameoverlayrenderer64=d"
  wine_in "$bottle" "$BACKEND" explorer.exe "/desktop=steam,${size:-1440x900}" \
    "$STEAM_EXE" "${STEAM_FLAGS[@]}" "$@"
}

cmd_steam() { # bottle [steam args...]
  local bottle="${1:?usage: macgames steam <bottle>}"; shift
  load_bottle "$bottle"
  steam_in "$bottle" "$@"
}

steam_running() { pgrep -f 'Program Files \(x86\)\\Steam\\steam\.exe' >/dev/null; }

steam_stop() { # needs WINEPREFIX, BACKEND
  WINEDEBUG=-all "$(wine_exe "$BACKEND")" "$STEAM_EXE" -shutdown >/dev/null 2>&1 || true
  local i; for ((i = 0; i < 30; i++)); do steam_running || break; sleep 1; done
  "$(wine_bin_dir "$BACKEND")/wineserver" -k 2>/dev/null || true
  for ((i = 0; i < 10; i++)); do steam_running || break; sleep 1; done
}

# Family View relocks on every Steam start and blocks all launches
# (AppError_45). Steam's UI exposes the PIN dialog's call over Chromium's
# DevTools port, opened by .cef-enable-remote-debugging in the Steam folder.
steam_unlock() { # pin [epoch Steam was started]; waits up to 2 minutes for Steam to be ready
  touch "$(steam_dir)/.cef-enable-remote-debugging"
  local plog="$(steam_dir)/logs/parental_log.txt" started="${2:-0}" i r
  # Before login the unlock answers 5 (invalid password), indistinguishable
  # from a wrong PIN, so wait until Steam applies Family View after logging on.
  for ((i = 0; i < 60; i++)); do
    [[ -f "$plog" && "$(stat -f %m "$plog")" -ge "$started" ]] && break
    sleep 2
  done
  for ((i = 0; i < 30; i++)); do
    r="$(python3 -I "$TOOLS/steam-cdp.py" "SteamClient.Parental.UnlockParentalLock('$1', true)" 2>/dev/null)" || r=""
    case "$r" in
      1) info "Family View unlocked"; return 0 ;;
      "") sleep 2 ;;
      *) die "Steam refused the Family View PIN (result $r)" ;;
    esac
  done
  die "couldn't reach Steam's UI to unlock Family View (restart Steam once so its debugging port opens)"
}

cmd_unlock() { # bottle [pin]
  local bottle="${1:?usage: macgames unlock <bottle> [pin]}" pin="${2:-${STEAM_PIN:-}}"
  [[ -n "$pin" ]] || die "no PIN given and STEAM_PIN isn't set in env/.env"
  load_bottle "$bottle"
  steam_unlock "$pin"
}

steamapps() { echo "$(steam_dir)/steamapps"; }

cmd_games() {
  local bottle="${1:?usage: macgames games <bottle>}"
  load_bottle "$bottle"
  shopt -s nullglob
  for m in "$(steamapps)"/appmanifest_*.acf; do
    local id name state
    id="$(sed -n 's/.*"appid"[[:space:]]*"\([0-9]*\)".*/\1/p' "$m" | head -1)"
    name="$(sed -n 's/.*"name"[[:space:]]*"\(.*\)".*/\1/p' "$m" | head -1)"
    state="$(sed -n 's/.*"StateFlags"[[:space:]]*"\([0-9]*\)".*/\1/p' "$m" | head -1)"
    printf '%-10s %-40s %s\n' "$id" "$name" "$([[ "$state" == 4 ]] && echo installed || echo "downloading/state=$state")"
  done
}

# games/<appid>/game.conf can set NAME, ARGS="..." and ENV="K=V K=V" for a game.
cmd_launch() { # bottle appid
  local bottle="${1:?usage: macgames launch <bottle> <appid>}" appid="${2:?missing appid}"
  load_bottle "$bottle"
  local NAME="" ARGS="" ENV=""
  if [[ -f "$GAMES/$appid/game.conf" ]]; then
    # shellcheck disable=SC1090
    source "$GAMES/$appid/game.conf"
    info "using games/$appid/game.conf${NAME:+ ($NAME)}"
  fi
  local kv; for kv in $ENV; do export "${kv?}"; done
  # A running Steam hands the launch to itself, and the game gets Steam's
  # environment, so restart it if it was started with other benchmark/MetalFX settings.
  if steam_running && [[ "$(cat "$(steam_session_file "$bottle")" 2>/dev/null)" != "$(steam_session)" ]]; then
    info "restarting Steam to apply $(steam_session)"
    steam_stop
  fi
  if [[ -z "${STEAM_PIN:-}" ]]; then
    # shellcheck disable=SC2086
    steam_in "$bottle" -applaunch "$appid" $ARGS
    return
  fi
  # With a Family View PIN: start Steam if needed, unlock, then hand it the launch.
  local started=0
  steam_running || { started="$(date +%s)"; steam_in "$bottle" >/dev/null 2>&1 & }
  steam_unlock "$STEAM_PIN" "$started"
  # shellcheck disable=SC2086
  WINEDEBUG=-all "$(wine_exe "$BACKEND")" "$STEAM_EXE" -applaunch "$appid" $ARGS >/dev/null 2>&1
  info "launched $appid; Steam keeps running in the background"
}

usage() {
  cat <<EOF
macgames — Windows games on Apple Silicon

  setup                          download Wine, DXMT and Game Porting Toolkit runtimes
  create <bottle> [backend]      new Wine prefix; backend: dxmt (default) | wined3d | d3dmetal
  list                           list bottles
  delete <bottle>                remove a bottle
  run <bottle> <exe> [args]      run a Windows program
  kill <bottle>                  stop everything in a bottle
  doctor <bottle>                check the Direct3D 12 path works in a bottle
  install-steam <bottle>         install Windows Steam
  steam <bottle>                 open Steam
  games <bottle>                 list Steam games in the bottle
  launch <bottle> <appid>        start a Steam game (applies games/<appid>/game.conf)
  unlock <bottle> [pin]          leave Steam Family View (PIN defaults to STEAM_PIN)

Settings live in env/.env (copy env/.env.example); shell variables override it:
  STEAM_PIN=1234                 unlock Family View before every launch
  SHOW_BENCHMARKS=true           FPS/frame time/memory overlay, top-right
  METALFX=1                      MetalFX upscaling (dxmt);  RETINA=0  low-DPI mode
  WINEDEBUG=+err                 more Wine logging (saved to bottles/<bottle>/last-run.log)
EOF
}

# Wrapped in main so bash parses the whole file before running anything.
main() {
  load_env
  cmd="${1:-help}"; shift || true
  case "$cmd" in
    setup) cmd_setup "$@" ;;
    create) cmd_create "$@" ;;
    list) cmd_list ;;
    delete) cmd_delete "$@" ;;
    run) cmd_run "$@" ;;
    kill) cmd_kill "$@" ;;
    doctor) cmd_doctor "$@" ;;
    install-steam) cmd_install_steam "$@" ;;
    steam) cmd_steam "$@" ;;
    games) cmd_games "$@" ;;
    launch) cmd_launch "$@" ;;
    unlock) cmd_unlock "$@" ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"; exit
