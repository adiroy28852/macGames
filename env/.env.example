# Copy to env/.env and fill in. env/.env is git-ignored; this file isn't, so
# keep real values out of it. Variables set in the shell override env/.env.

# Steam Family View PIN. When set, `launch` unlocks Family View first.
STEAM_PIN=

# Metal performance overlay (FPS, frame time, GPU time, memory) in the
# top-right corner of the game. Turns on automatically when a game launches.
SHOW_BENCHMARKS=false

# Optional:
# METALFX=1            # MetalFX upscaling (dxmt bottles)
# RETINA=0             # low-DPI mode instead of full Retina resolution
# DESKTOP=1920x1080    # Steam virtual desktop size (default: screen size)
# WINEDEBUG=+err       # more Wine logging, saved to bottles/<bottle>/last-run.log
